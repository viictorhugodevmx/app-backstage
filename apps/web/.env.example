# Copiar a apps/web/.env.local y completar los secretos.
# Next.js carga .env.local desde la raíz de apps/web.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://backstage.local/api

API_INTERNAL_URL=http://api:3001
