  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "source-map-support": "0.5.21",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "@swc/core": "1.16.13",
    "unplugin-swc": "2.0.0"
  }
